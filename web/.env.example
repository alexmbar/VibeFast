# ============================================================
# VibeFast — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Encuentra estas keys en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- PostHog (opcional, analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- OAuth providers (Gmail receta, opcional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Drive (subida de tickets/estados de cuenta por WhatsApp) ---
# Client ID/Secret: Google Cloud Console -> APIs & Services -> Credentials
# Encryption key: genera una vez con `openssl rand -base64 32`
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# --- Kapso WhatsApp (captura automática de gastos) ---
# API key: https://app.kapso.ai -> Integrations -> API keys
# Phone number ID: dashboard -> Phone numbers -> tu número -> Phone Number ID
# Webhook secret: dashboard -> Phone numbers -> tu número -> Webhooks -> Secret
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# --- Cron (generación de recurrencias) ---
# Cualquier valor secreto random; Vercel lo manda solo en el header
# Authorization del cron configurado en vercel.json. Genera uno con
# `openssl rand -hex 32` o similar.
CRON_SECRET=